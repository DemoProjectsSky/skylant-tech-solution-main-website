# ---- Browser (public: anything starting with VITE_ is visible to every visitor; NEVER put secrets here) ----
VITE_API_URL=http://localhost:5001      # dashboard API that stores website leads (POST /api/public/leads)
VITE_SITE_URL=https://www.example.com   # public address of this website (canonical URLs, social previews)

# ---- Server only (Vercel Environment Variables or local .env) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                           # 465 = implicit TLS, 587 = STARTTLS
SMTP_SECURE=                            # optional: true/false (defaults from the port)
SMTP_USER=
SMTP_PASS=                              # for Gmail use an App Password
MAIL_FROM=                              # optional, defaults to SMTP_USER
MAIL_TO=hr.skylant@gmail.com            # who receives contact and job-application emails
ALLOWED_ORIGINS=https://www.example.com # origins allowed to call /api/*; same-host requests are always allowed
MAIL_RATE_LIMIT=5                       # emails per IP per 10 minutes
GROQ_API_KEY=                           # AI assistant key (server only!). Leave empty to disable the assistant
GROQ_MODEL=llama-3.1-8b-instant
CHAT_RATE_LIMIT=20                      # assistant messages per IP per 10 minutes
PORT=5000                               # local dev API server only
SITE_URL=https://www.example.com        # used at build time to generate sitemap.xml
